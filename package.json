{
  "name": "workbench",
  "version": "5.0.0",
  "description": "Lightweight SDD + VDD Spec & Verification Workbench for AI Coding Agents",
  "type": "module",
  "bin": {
    "wb": "./src/cli/index.ts"
  },
  "scripts": {
    "wb": "bun run src/cli/index.ts",
    "serve": "bun run src/cli/index.ts serve",
    "mcp": "bun run src/cli/index.ts mcp",
    "deploy": "bun run scripts/deploy.ts",
    "deploy:check": "bun run scripts/check-deployment.ts",
    "test": "bun run scripts/test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/bun": "latest",
    "@types/diff": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "puppeteer-core": "^25.18.1",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/node": "4.3.5",
    "@tailwindcss/oxide": "4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "chart.js": "^4.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "lucide-react": "1.73.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4.3.5",
    "zustand": "^5.1.0"
  }
}
